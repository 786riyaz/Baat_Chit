PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_clone
JWT_SECRET=replace_with_a_long_random_secret

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
