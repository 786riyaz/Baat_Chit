# Single server on one port serves the Next.js frontend, the REST API, and
# Socket.IO. No separate frontend port/URL needed - it's all one origin now.
PORT=3000
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=development
NODE_ENV=production

MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_clone

AWS_REGION=aws_region
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your_bucket_name

# Message Archive Cron Job Settings
ARCHIVE_BATCH_SIZE=1000
# Format :: minute hour day-of-month month day-of-week
ARCHIVE_CRON_SCHEDULE=* * * * *     # Run every minute
ARCHIVE_CRON_SCHEDULE=0 * * * *     # Run every hour at the start of the hour
ARCHIVE_CRON_SCHEDULE=0 0 * * *     # Run every day at midnight
ARCHIVE_AFTER_HOURS=0.01    # Archive messages older than 0.01 hours (36 seconds)
ARCHIVE_AFTER_HOURS=1       # Archive messages older than 1 hour
ARCHIVE_AFTER_HOURS=24      # Archive messages older than 24 hours

# Exercise 18 Gemini AI (keep disabled unless you are demoing it)
AI_SUGGESTIONS_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Approval / free-trial system
# Any signup using this exact email becomes role=admin, approvalStatus=approved automatically.
ADMIN_EMAIL=admin@example.com
# Total trial messages (personal + group + media, combined) a pending user may send.
FREE_MESSAGE_LIMIT=10

# Profile management + forgot/reset password
# This app's own URL - used to build the password-reset email link.
# In production this is your single deployed URL (one service, not two).
FRONTEND_URL=http://localhost:3000
RESET_TOKEN_EXPIRY_MINUTES=15

# Gmail requires a Google "App Password" here (Account > Security > App Passwords
# with 2FA enabled) - your normal Gmail password will be rejected.
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false