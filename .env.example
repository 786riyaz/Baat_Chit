# Single server on one port serves the Next.js frontend, the REST API, and
# Socket.IO. No separate frontend port/URL needed - it's all one origin now.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_clone
JWT_SECRET=replace_with_a_long_random_secret

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your_bucket_name

# Exercise 17 message archiving
ARCHIVE_AFTER_HOURS=24
ARCHIVE_BATCH_SIZE=1000
ARCHIVE_CRON_SCHEDULE=0 0 * * *

# Exercise 18 Gemini AI (keep disabled unless you are demoing it)
AI_SUGGESTIONS_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Exercise 19 approval / free-trial system
# Any signup using this exact email becomes role=admin, approvalStatus=approved automatically.
ADMIN_EMAIL=admin@example.com
# Total trial messages (personal + group + media, combined) a pending user may send.
FREE_MESSAGE_LIMIT=10

# Exercise 20 profile management + forgot/reset password
# This app's own URL - used to build the password-reset email link.
# In production this is your single deployed URL (one service, not two).
FRONTEND_URL=http://localhost:3000
RESET_TOKEN_EXPIRY_MINUTES=15
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Gmail requires a Google "App Password" here (Account > Security > App Passwords
# with 2FA enabled) - your normal Gmail password will be rejected.
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
