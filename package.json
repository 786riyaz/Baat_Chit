{
  "name": "chat-app",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp-inspired real-time chat app - Next.js frontend, Express + Socket.IO backend, single unified project and single dev server",
  "main": "server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "nodemon --watch server.js --watch server --ext js,json server.js",
    "build": "next build",
    "test": "cross-env NODE_ENV=production node server.js",
    "start": "node server.js",
    "migrate:approval": "node server/scripts/migrateExistingUsers.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@google/genai": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "cron": "^4.3.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "next": "^14.2.15",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9"
  }
}
